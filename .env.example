# 复制为 .env 后填写。带 # 的行是可选项：去掉 # 再填值即可生效，不填使用默认值。

# ---- Telegram（必填）----
# Telegram Bot token（由 BotFather 提供）
TELEGRAM_BOT_TOKEN=
# 允许的 chat id，以逗号分隔。私聊通常是正数；群聊是负数。
TELEGRAM_CHAT_IDS=
# 主人私聊的 chat id（正整数），必须同时写在 TELEGRAM_CHAT_IDS 中；只有它能执行管理命令
ALICE_OWNER_CHAT_ID=

# ---- 模型（任何兼容 Anthropic Messages 协议的服务）----
# 以下 LLM_* 填了就优先于 config.yaml 的 model 设置。
# 服务地址：注释掉为 Anthropic 官方 https://api.anthropic.com；必须是 https（仅本机代理可用 http）
LLM_BASE_URL=https://api.deepseek.com/anthropic
# 对应服务的 API key（必填；旧变量名 ANTHROPIC_API_KEY 仍可用）
LLM_API_KEY=
# 主模型。Claude 例：claude-sonnet-5-5；DeepSeek 例：deepseek-flash、deepseek-v4-pro
LLM_MODEL=deepseek-flash

# 压缩/整理用的模型，不填复用主模型
# LLM_COMPACTION_MODEL=
# 氛围分析（Alter System）用的模型，不填复用主模型
# LLM_ALTER_MODEL=
# 主叙事单次最多输出多少 token，默认 4096
# LLM_MAX_TOKENS=4096
# 主叙事超时秒数，默认 60
# LLM_TIMEOUT_SECONDS=60
# 是否把图片发给模型识别（true/false），默认 false
# LLM_VISION=false
