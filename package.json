{
  "name": "alice-hdsi-telegram",
  "version": "0.1.3",
  "description": "A macOS Telegram narrative bot powered by Anthropic Messages.",
  "main": "lib/main.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "start": "node --env-file-if-exists=.env lib/main.js",
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "build": "node scripts/build.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "files": ["lib", "README.md", "DEPLOYMENT_GUIDE.md", "CONFIGURATION_GUIDE.md", "BEGINNER_GUIDE.md", "command.md", "docs/ARCHITECTURE.md", "docs/ALTER_SYSTEM.md", "docs/AGENCY_WINDOW.md", "docs/CHANGELOG.md", "docs/SECURITY.md"],
  "keywords": ["telegram", "claude", "roleplay", "narrative"],
  "license": "AGPL-3.0",
  "private": true,
  "os": ["darwin"],
  "engines": {"node": ">=22.14.0 <25"},
  "dependencies": { "puppeteer-core": "^24.0.0" },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0"
  }
}


